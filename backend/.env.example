# Copy this file to .env and fill in real values locally.
# Never commit .env with real credentials.

# PostgreSQL connection string used by app/indexing. Requires the pgvector
# extension to be installed in the target database (CREATE EXTENSION vector).
DATABASE_URL=postgresql+psycopg://raguser:changeme@localhost:5432/enterprise_rag

# Optional. Pins the pgvector `embedding` column to a fixed dimension once an
# embedding model has been chosen (e.g. 1536 for gemini-embedding-2).
# Leave unset to keep the column dimension-agnostic.
EMBEDDING_DIMENSION=

# Required only if using GeminiEmbeddingProvider (app/embeddings/gemini.py).
# Get a key at https://ai.google.dev/gemini-api/docs/api-key. Calls to the
# Gemini embedding API use network access and may incur charges outside the
# applicable free tier. Not required for BGEEmbeddingProvider or
# DeterministicTestEmbeddingProvider, which do not call this API.
GEMINI_API_KEY=

# Selects which EmbeddingProvider the API (app/api/dependencies.py) builds
# at request time: "bge" (local, no API key, default), "gemini" (needs
# GEMINI_API_KEY above), or "deterministic" (test/dev only, non-semantic).
# Leave unset to use the default ("bge").
EMBEDDING_PROVIDER=

# Optional. Overrides the Gemini text-generation model GeminiLLMProvider
# (app/rag/llm.py) uses for RAG answer generation. Leave unset to use the
# default ("gemini-3.7-flash"). Requires GEMINI_API_KEY above -- there is
# currently no local/offline LLMProvider (unlike embeddings' BGE option).
GEMINI_LLM_MODEL=

# Optional. Fallback generation model used only after the primary model returns
# repeated temporary service-unavailable errors. Leave unset/blank to use the
# default fallback ("gemini-3.5-flash"). Set to "none" to disable fallback.
GEMINI_LLM_FALLBACK_MODEL=
